{
  "openapi": "3.1.0",
  "info": {
    "title": "GRACE ACS Risk Calculator API",
    "description": "Historical Granger 2003 in-hospital point scoring, not GRACE 2.0 or six-month mortality. Generic audit endpoints are legacy demonstrations.",
    "version": "3.1.0"
  },
  "paths": {
    "/api/grace": {
      "post": {
        "summary": "Calculate original GRACE in-hospital point score",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "age",
                  "heart_rate",
                  "systolic_bp",
                  "creatinine",
                  "killip_class"
                ],
                "properties": {
                  "age": {
                    "type": "integer",
                    "minimum": 18,
                    "maximum": 120
                  },
                  "heart_rate": {
                    "type": "integer",
                    "minimum": 20,
                    "maximum": 300
                  },
                  "systolic_bp": {
                    "type": "integer",
                    "minimum": 50,
                    "maximum": 300
                  },
                  "creatinine": {
                    "type": "number",
                    "minimum": 0.1,
                    "maximum": 20,
                    "description": "mg/dL"
                  },
                  "killip_class": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4
                  },
                  "cardiac_arrest": {
                    "type": "boolean",
                    "default": false
                  },
                  "st_deviation": {
                    "type": "boolean",
                    "default": false
                  },
                  "elevated_markers": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Score, components, historical anchor and limitations"
          },
          "422": {
            "description": "Invalid clinical parameters"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health and version",
        "responses": {
          "200": {
            "description": "Service health metadata"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Legacy in-memory audit demo counters (JSON)",
        "responses": {
          "200": {
            "description": "Counters"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Legacy generic worker demonstration; not a clinical calculator",
        "responses": {
          "200": {
            "description": "Demonstration task dossier"
          },
          "422": {
            "description": "Invalid task"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic mock response, not clinical inference",
        "responses": {
          "200": {
            "description": "Mock response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Legacy audit log (disabled unless ENABLE_AUDIT_LOGS=1)",
        "responses": {
          "200": {
            "description": "In-memory audit records"
          },
          "403": {
            "description": "Endpoint disabled"
          }
        }
      }
    }
  }
}
